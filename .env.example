# Local ChatGPT desktop test — do not commit your real .env file.
# Node.js 22+ is required for --env-file support.

# ElevenLabs credentials (no OpenAI API key is used)
ELEVENLABS_API_KEY=PASTE_YOUR_ELEVENLABS_API_KEY_HERE
ELEVENLABS_VOICE_ID=aCYMtkaPL6diKGOdI84H
ELEVENLABS_MODEL_ID=eleven_v4
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# Local-only HTTP MCP server. Keep HOST on loopback for the no-OAuth test.
HOST=127.0.0.1
PORT=8765
MCP_PUBLIC_BASE_URL=http://127.0.0.1:8765
MCP_SOUNDSCAPE_TOOLS_ENABLED=true
BOT_NAME=Shin

# Private browser preview / audio-library management password (32+ characters).
# Replace this placeholder with a random value before starting.
PRIVATE_DRAMA_ACCESS_TOKEN=replace-this-local-only-secret-with-a-random-64-character-value

# Local audio files stay inside this project directory.
AUDIO_ASSET_DIR=./data/audio-assets
AUDIO_ASSET_MAX_BYTES=20971520
AUDIO_ASSET_MAX_COUNT=100
AUDIO_ASSET_MAX_TOTAL_BYTES=209715200

# Conservative usage limits for the local test.
MCP_MAX_REQUESTS_PER_MINUTE=60
VOICE_MAX_CALLS_PER_MINUTE=8
VOICE_MAX_CALLS_PER_DAY=120
VOICE_MAX_CHARS_PER_DAY=12000
VOICE_MAX_CONCURRENT_SYNTHESIS=2
